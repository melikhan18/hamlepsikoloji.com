# ======================================================================
# FRONTEND (Next.js) üretim ortam değişkenleri
# Kopyala:  cp deploy/env/frontend.env.example /opt/hamle/env/frontend.env
# NOT: NEXT_PUBLIC_API_URL BUILD anında gömülür — deploy.sh build öncesi yükler.
# ======================================================================

# Backend API adresi (tarayıcıdaki form bu adrese gider)
NEXT_PUBLIC_API_URL=https://api.hamlepsikoloji.com

# Sunucu tarafı istekler (build + ISR) için İÇ adres — Cloudflare'e çıkmadan
# doğrudan localhost'taki backend'e gider. Build zaman aşımlarını önler.
API_URL_INTERNAL=http://localhost:8081

# Revalidation webhook secret — backend.env ile AYNI olmalı
REVALIDATE_SECRET=DEGISTIR_backend_ile_AYNI_deger

# Çalışma
NODE_ENV=production
PORT=3000
