# ======================================================================
# BACKEND (Spring Boot) üretim ortam değişkenleri
# Kopyala:  cp deploy/env/backend.env.example /opt/hamle/env/backend.env
# Sonra DEĞİŞTİR yazan yerleri doldur (gen-secrets.sh yardımcı olur).
# ======================================================================

# ---- Veritabanı (docker-compose.prod.yml ile aynı değerler) ----
DB_NAME=hamle
DB_USER=hamle
DB_PASSWORD=DEGISTIR_guclu_db_sifresi
DB_URL=jdbc:postgresql://localhost:5432/hamle

# ---- Sunucu (Nginx arkasında, localhost) ----
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1

# ---- Admin girişi (panel) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DEGISTIR_guclu_admin_sifresi

# ---- JWT (en az 32 karakter) ----
JWT_SECRET=DEGISTIR_openssl_rand_hex_32

# ---- CORS: siteye izin verilen origin'ler (virgülle) ----
CORS_ORIGINS=https://hamlepsikoloji.com,https://www.hamlepsikoloji.com

# ---- Görsel yükleme ----
UPLOADS_DIR=/opt/hamle/uploads
UPLOADS_BASE_URL=https://api.hamlepsikoloji.com/uploads

# ---- On-demand revalidation (ön yüz webhook) ----
# Not: aynı sunucudaysa iç adres daha güvenilir: http://localhost:3000/api/revalidate
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=DEGISTIR_frontend_ile_AYNI_deger

# ---- Google Analytics dashboard (opsiyonel) ----
# GA4 MÜLK kimliği (sayısal; GA > Yönetici > Mülk ayrıntıları — ölçüm kimliği G-... DEĞİL)
#GA_PROPERTY_ID=
# Servis hesabı JSON anahtarının sunucudaki yolu
#GA_SA_KEY_PATH=/opt/hamle/env/ga-key.json
